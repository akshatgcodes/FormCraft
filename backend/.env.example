# Postgres in production (Neon etc.). Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/formcraft

# Password for the form owner (builder + responses). Required.
ADMIN_PASSWORD=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Where the React app runs (CORS)
FRONTEND_URL=http://localhost:5173

# true in production when frontend and API are on different domains
CROSS_SITE_COOKIES=false
